DATABASE_PROVIDER=sqlite
# PostgreSQL (docker compose)
DATABASE_URL="file:./dev.db"
# Para PostgreSQL: DATABASE_URL="postgresql://scraping:scraping@localhost:54329/scraping?schema=public"
# and DATABASE_PROVIDER=postgresql (default: sqlite)

# Redis (docker compose)
REDIS_HOST=localhost
REDIS_PORT=6380
# Set for hosted Redis (e.g. Redis Cloud). Leave empty for local Redis.
REDIS_PASSWORD=
REDIS_TLS=false
# true = run the queue worker inside this process (single-process deployments)
ENABLE_WORKER=false

# API
PORT=3000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173

# Worker
WORKER_CONCURRENCY=2
MAX_PAGES_LIMIT=50
ALLOW_PRIVATE_HOSTS=false

# Admin inicial (seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-password
