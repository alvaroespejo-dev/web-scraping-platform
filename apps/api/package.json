{
  "name": "@scraping/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/use-database.js && prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts",
    "db:push": "node scripts/use-database.js && prisma db push",
    "seed": "ts-node -r tsconfig-paths/register src/prisma/seed.ts",
    "seed:cases": "ts-node -r tsconfig-paths/register src/prisma/seed-cases.ts",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.config.js --runInBand"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.2",
    "axios": "^1.21.1",
    "bullmq": "^6.7.3",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.4",
    "dotenv": "^16.6.1",
    "ioredis": "5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "playwright": "^1.65.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
